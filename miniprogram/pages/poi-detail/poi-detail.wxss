/* POI 详情页样式 */
.poi-page {
  min-height: 100vh;
  background-color: #ffffff;
  padding-bottom: 160rpx;
}

/* 沉浸式头部 */
.poi-header {
  position: relative;
  width: 100%;
  height: 35vh;
}

.poi-header-img {
  width: 100%;
  height: 100%;
}

.poi-header-placeholder {
  width: 100%;
  height: 100%;
  background-color: #e5e7eb;
}

.poi-header-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(to top, #ffffff, rgba(255,255,255,0.2), transparent);
}

.poi-header-title {
  position: absolute;
  bottom: 48rpx;
  left: 48rpx;
  font-size: 44rpx;
  font-weight: bold;
  color: #111827;
}

/* 快捷信息 */
.poi-stats {
  margin-top: -16rpx;
  position: relative;
  z-index: 10;
  margin-left: 40rpx;
  margin-right: 40rpx;
  display: flex;
  background-color: rgba(249, 250, 251, 0.8);
  backdrop-filter: blur(12px);
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f3f4f6;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.stat-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  margin-top: 8rpx;
}

.stat-success { color: var(--color-success); }
.stat-warning { color: var(--color-warning); }
.stat-danger { color: var(--color-danger); }

.stat-divider {
  width: 1rpx;
  background-color: rgba(229, 231, 235, 0.6);
  margin: 0 4rpx;
}

/* 描述 */
.poi-description {
  padding: 64rpx 48rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 2;
}

.desc-update {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 32rpx;
}

/* 底部操作栏 */
.poi-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: 100%;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(24px);
  border-top: 1rpx solid #f3f4f6;
  padding: 24rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 50;
}

.bottom-actions {
  display: flex;
  gap: 32rpx;
}

.action-btn {
  padding: 16rpx;
  color: #9ca3af;
}

.action-icon {
  font-size: 40rpx;
}

.nav-btn {
  background: linear-gradient(to right, var(--color-brand), #4b5563);
  color: #ffffff;
  font-weight: bold;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 80, 0.3);
}

.nav-btn-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 加载状态 */
.loading-full {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: #f9fafb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 8rpx solid #e5e7eb;
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  color: #6b7280;
  font-size: 28rpx;
  margin-top: 32rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
