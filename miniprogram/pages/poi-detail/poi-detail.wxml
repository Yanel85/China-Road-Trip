<!--POI详情页 - 对应原项目 POICard-->
<view class="poi-page" wx:if="{{!loading && poi}}">
  <!-- 沉浸式头部 -->
  <view class="poi-header">
    <image
      wx:if="{{poi.images && poi.images.length > 0}}"
      src="{{poi.images[0]}}"
      mode="aspectFill"
      class="poi-header-img"
    />
    <view wx:else class="poi-header-placeholder"></view>
    <view class="poi-header-overlay"></view>
    <text class="poi-header-title">{{poi.title}}</text>
  </view>

  <!-- 快捷信息 -->
  <view class="poi-stats">
    <view class="stat-item">
      <text class="stat-label">海拔</text>
      <text class="stat-value">{{poi.altitude ? 'ALT ' + poi.altitude + 'm' : '-'}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-label">分类</text>
      <text class="stat-value">{{poi.type}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-label">实时路况</text>
      <text class="stat-value {{poi.roadStatus === '畅通' ? 'stat-success' : poi.roadStatus === '拥堵' ? 'stat-warning' : 'stat-danger'}}">{{poi.roadStatus}}</text>
    </view>
  </view>

  <!-- 描述 -->
  <view class="poi-description">
    <text class="desc-text">{{poi.description || '暂无描述'}}</text>
    <text class="desc-update" wx:if="{{poi.liveUpdate}}">最后更新: {{poi.liveUpdate}}</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="poi-bottom-bar">
    <view class="bottom-actions">
      <view class="action-btn">
        <text class="action-icon">♡</text>
      </view>
      <view class="action-btn">
        <text class="action-icon">↗</text>
      </view>
    </view>
    <view class="nav-btn" bindtap="onNavigate">
      <text class="nav-btn-text">立即导航</text>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-full" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">载入点位数据...</text>
</view>
