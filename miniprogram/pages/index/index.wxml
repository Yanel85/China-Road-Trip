<!--首页 - 地图 + 底部路线列表面板-->
<view class="page-container">
  <!-- 地图 -->
  <map
    id="mainMap"
    class="main-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    polyline="{{mapPolyline}}"
    enable-zoom
    enable-scroll
  >
  </map>

  <!-- 底部面板 -->
  <view class="bottom-sheet {{sheetExpanded ? 'expanded' : ''}}">
    <!-- 拖拽条 -->
    <view class="drag-handle" bindtap="onToggleSheet">
      <view class="drag-bar"></view>
    </view>

    <!-- 标题行 -->
    <view class="sheet-header" bindtap="onToggleSheet">
      <text class="sheet-title">路线列表</text>
      <text class="sheet-count" wx:if="{{checkedIds.length > 0}}">已选 {{checkedIds.length}} 条线路</text>
    </view>

    <!-- 展开内容 -->
    <view class="sheet-content" wx:if="{{sheetExpanded}}">
      <!-- 标签筛选 -->
      <scroll-view scroll-x class="tags-scroll" wx:if="{{allTags.length > 0}}">
        <view class="tags-list">
          <view
            wx:for="{{allTags}}"
            wx:key="*this"
            class="tag-item {{selectedTag === item ? 'tag-active' : ''}}"
            data-tag="{{item}}"
            bindtap="onTagTap"
          >
            {{item}}
          </view>
        </view>
      </scroll-view>

      <!-- 路线列表 -->
      <view class="route-list" wx:if="{{!loading}}">
        <view
          wx:for="{{filteredRoutes}}"
          wx:key="id"
          class="route-item"
        >
          <view class="route-card-row">
            <!-- 蓝底白字简称 + 详情按钮（点击查看详情） -->
            <view class="thumb-wrap" data-id="{{item.id}}" catchtap="onRouteTap">
              <view class="route-thumb-text {{item._isAlphanumeric ? 'thumb-alpha' : 'thumb-cjk'}}">
                <text class="route-thumb-label">{{item._shortName}}</text>
              </view>
              <view class="detail-btn">
                <text class="detail-btn-text">查看详情</text>
              </view>
            </view>
            <!-- 信息区 + 勾选框（点击勾选） -->
            <view class="route-info {{checkedIds.indexOf(item.id) > -1 ? 'info-checked' : ''}}" data-id="{{item.id}}" catchtap="onCheckTap">
              <view class="route-info-left">
                <text class="route-name">{{item.title}}</text>
                <text class="route-season" wx:if="{{item.season && item.season.length > 0}}">{{item.season.join('/')}}</text>
                <view class="route-meta-row">
                  <text class="route-distance">{{item.distance}} km</text>
                  <text class="route-status">{{item.status}}</text>
                </view>
              </view>
              <view class="check-box {{checkedIds.indexOf(item.id) > -1 ? 'checked' : ''}}">
                <text class="check-icon" wx:if="{{checkedIds.indexOf(item.id) > -1}}">✓</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{filteredRoutes.length === 0}}">
          <text class="empty-text">没有找到相关的匹配结果</text>
        </view>
      </view>

      <!-- 加载状态 -->
      <view class="loading-state" wx:if="{{loading}}">
        <view class="loading-skeleton" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="skeleton-image"></view>
          <view class="skeleton-content">
            <view class="skeleton-title"></view>
            <view class="skeleton-subtitle"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提示（始终可见，折叠时也显示在标题下方） -->
    <view class="footer-tip" bindtap="onCopyUrl">
      <text class="footer-tip-text">想要创建自定义线路？请电脑访问 </text>
      <text class="footer-tip-url">go.xwabc.cn</text>
    </view>
  </view>
</view>
