<!--首页 - 对应原项目 ResponsiveHome 移动端部分-->
<view class="page-container">
  <!-- 搜索栏 -->
  <search-bar value="{{query}}" bindinput="onSearchInput" placeholder="搜索你想去的景点或路线..." />

  <!-- 标签筛选 -->
  <view class="tags-section" wx:if="{{allTags.length > 0}}">
    <view class="tags-list">
      <view
        wx:for="{{allTags}}"
        wx:key="*this"
        class="tag-item {{selectedTag === item ? 'tag-active' : ''}}"
        data-tag="{{item}}"
        bindtap="onTagTap"
      >
        {{item}}
      </view>
    </view>
  </view>

  <!-- 路线列表 -->
  <view class="route-list" wx:if="{{!loading}}">
    <block wx:for="{{filteredRoutes}}" wx:key="id">
      <view class="route-item" data-id="{{item.id}}" bindtap="onRouteTap">
        <route-card data="{{item}}" is-favorited="{{favorites.indexOf(item.id) > -1}}" bindfavoritechange="onFavoriteChange" />
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredRoutes.length === 0}}">
      <text class="empty-text">没有找到相关的匹配结果</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-skeleton" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-image"></view>
      <view class="skeleton-content">
        <view class="skeleton-title"></view>
        <view class="skeleton-subtitle"></view>
      </view>
    </view>
  </view>
</view>
