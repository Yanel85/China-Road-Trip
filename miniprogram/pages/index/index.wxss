/* 首页 - 地图 + 底部面板 */
.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* 地图 */
.main-map {
  width: 100%;
  height: 100%;
}

/* 底部面板 */
.bottom-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background-color: #ffffff;
  border-radius: 60rpx 60rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 99;
  transition: height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
}

.bottom-sheet.expanded {
  height: 78vh;
}

/* 拖拽条 */
.drag-handle {
  width: 100%;
  height: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #9ca3af;
}

.drag-bar {
  width: 120rpx;
  height: 10rpx;
  background-color: #d1d5db;
  border-radius: 10rpx;
}

/* 面板标题 */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx;
  margin-bottom: 6rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #111827;
}

.sheet-count {
  font-size: 22rpx;
  color: #6b7280;
}

/* 面板内容 */
.sheet-content {
  padding: 0 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  overflow-y: auto;
  max-height: calc(75vh - 120rpx);
}

/* 标签 */
.tags-scroll {
  margin-bottom: 8rpx;
}

.tags-list {
  display: inline-flex;
  white-space: nowrap;
  gap: 12rpx;
  padding: 4rpx 0;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  background-color: #f3f4f6;
  color: #6b7280;
}

.tag-active {
  background-color: #e5e7eb;
  color: #374151;
}

/* 路线列表 */
.route-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.route-item {
  position: relative;
}

.route-card-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 图片/文字区域 */
.thumb-wrap {
  position: relative;
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.route-thumb-text {
  width: 100%;
  height: 100%;
  background-color: #3665c9;
  display: flex;
  padding: 8rpx 1rpx;
  box-sizing: border-box;
}

/* 中文内容：两排显示 */
.thumb-cjk .route-thumb-label {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
}

/* 英文/数字：大字号填满 */
.thumb-alpha .route-thumb-label {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
  line-height: 1.1;
  letter-spacing: 2rpx;
}

/* 详情按钮 - 图片底部橙色 */
.detail-btn {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 32rpx;
  background-color: #F39C12;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-btn-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 信息区 + 勾选 */
.route-info {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.route-info-left {
  flex: 1;
  min-width: 0;
}

.info-checked {
  background-color: #f0fdf4;
  border-radius: 12rpx;
}

.route-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-season {
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.route-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.route-distance {
  font-size: 20rpx;
  color: #9ca3af;
}

.route-status {
  font-size: 18rpx;
  color: #6b7280;
  background-color: #f3f4f6;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 右侧勾选框 */
.check-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-box.checked {
  background-color: #22c55e;
  border-color: #22c55e;
}

.check-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  color: #6b7280;
  font-size: 28rpx;
}

/* 底部提示 */
.footer-tip {
  margin: 8rpx 28rpx;
  padding: 10rpx;
  text-align: center;
  border: 2rpx dashed #d1d5db;
  border-radius: 26rpx;
  background-color: #fbf48d;
}

.footer-tip-text {
  font-size: 26rpx;
  color: #0a0a0a;
}

.footer-tip-url {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

/* 加载骨架 */
.loading-state {
  margin-top: 16rpx;
}

.loading-skeleton {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

.skeleton-image {
  width: 100rpx;
  height: 100rpx;
  background: #e5e7eb;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}

.skeleton-title {
  width: 60%;
  height: 28rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
}

.skeleton-subtitle {
  width: 40%;
  height: 22rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
