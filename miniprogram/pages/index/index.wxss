/* 首页样式 - 对应原项目 ResponsiveHome 移动端 */
.page-container {
  min-height: 100vh;
  background-color: var(--color-background);
  padding-bottom: 120rpx;
}

/* 标签区域 */
.tags-section {
  padding: 0 40rpx;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  background-color: #f3f4f6;
  color: #6b7280;
  transition: all 0.2s;
}



/* 路线列表 */
.route-list {
  padding: 16rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.route-item {
  position: relative;
}

.delete-btn {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 56rpx;
  height: 56rpx;
  background-color: #fef2f2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-icon {
  color: #ef4444;
  font-size: 28rpx;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-text {
  color: #6b7280;
  font-size: 28rpx;
}

/* 加载骨架 */
.loading-state {
  padding: 32rpx 40rpx;
}

.loading-skeleton {
  display: flex;
  gap: 32rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

.skeleton-image {
  width: 160rpx;
  height: 160rpx;
  background: #e5e7eb;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 8rpx;
}

.skeleton-title {
  width: 60%;
  height: 32rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
}

.skeleton-subtitle {
  width: 40%;
  height: 24rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 创建按钮 */
.create-btn {
  position: fixed;
  bottom: 200rpx;
  right: 32rpx;
  width: 112rpx;
  height: 112rpx;
  background-color: #000000;
  color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  z-index: 50;
}

.create-icon {
  font-size: 40rpx;
  font-weight: bold;
}

.create-text {
  font-size: 20rpx;
  font-weight: bold;
}
