<!--探索地图页 - 对应原项目 /map 页面-->
<view class="map-page">
  <map
    id="exploreMap"
    class="explore-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    enable-zoom
    enable-scroll
  >
  </map>

  <!-- 收藏线路面板 -->
  <explore-map-panel routes="{{routes}}" favorites="{{favorites}}" />

</view>
