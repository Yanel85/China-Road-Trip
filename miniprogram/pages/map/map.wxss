/* 探索地图页样式 */
.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.explore-map {
  width: 100%;
  height: 100%;
}

.back-btn {
  position: absolute;
  bottom: 120rpx;
  left: 32rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  z-index: 40;
}

.back-icon {
  font-size: 40rpx;
  color: #374151;
  font-weight: bold;
}
