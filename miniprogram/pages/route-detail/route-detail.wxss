/* 路线详情页样式 */
.detail-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #cbd5e1;
}

/* 地图区域 */
.map-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  transition: height 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.route-map {
  width: 100%;
  height: 100%;
}

/* 底部抽屉 */
.bottom-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.12);
  z-index: 50;
  transition: height 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
}

.drag-handle {
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 60;
}

.drag-bar {
  width: 80rpx;
  height: 12rpx;
  background-color: #d1d5db;
  border-radius: 12rpx;
}

/* 路线标题 */
.sheet-header {
  position: absolute;
  top: 56rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
  cursor: pointer;
  z-index: 60;
}

.route-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #111827;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sort-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feedback-btn {
  font-size: 20rpx;
  color: #3b82f6;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  border-radius: 0;
  line-height: 2;
}

.feedback-btn::after {
  border: none;
}

.route-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  font-size: 20rpx;
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-open { background-color: var(--color-success); }
.status-warning { background-color: var(--color-warning); }
.status-danger { background-color: var(--color-danger); }

/* 展开内容 */
.sheet-content {
  position: absolute;
  top: 150rpx;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
  padding: 0 40rpx;
  padding-bottom: 120rpx;
}

/* 海拔图表区域 */
.chart-section {
  margin-bottom: 32rpx;
  margin-top: 16rpx;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.sort-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.sort-controls {
  display: flex;
  gap: 16rpx;
}

.sort-btn {
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
}

.sort-active {
  color: var(--color-brand);
}

/* POI 列表 */
.poi-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.poi-item {
  padding-left: 24rpx;
  border-left-width: 6rpx;
  border-left-style: solid;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.poi-border-green { border-left-color: #22c55e; }
.poi-border-red { border-left-color: #ef4444; }
.poi-border-yellow { border-left-color: #eab308; }
.poi-border-gray { border-left-color: #d1d5db; }

.poi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.poi-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.poi-altitude {
  font-size: 20rpx;
  color: #6b7280;
  background-color: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.poi-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.6;
}

/* POI 详情弹窗 */
.poi-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 120rpx;
  background-color: rgba(0, 0, 0, 0.1);
}

.poi-popup-card {
  width: 90%;
  max-width: 680rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
  position: relative;
}


.poi-popup-type {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background-color: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}


.poi-popup-close-noimg {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  background-color: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 10;
}

.poi-popup-info {
  padding: 24rpx 28rpx;
}

.poi-popup-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.poi-popup-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #111827;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-popup-alt {
  font-size: 20rpx;
  font-weight: 600;
  background-color: #f3f4f6;
  color: #4b5563;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-right: 80rpx;
}

.poi-popup-desc {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.poi-popup-nav {
  width: 45%;
  padding: 14rpx 0;
  background-color: var(--color-brand);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
}

/* 加载状态 */
.loading-full {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #cbd5e1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 8rpx solid #ffffff;
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 32rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.not-found {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f9fafb;
}

.not-found-text {
  color: #9ca3af;
  font-weight: bold;
  text-transform: uppercase;
}
