/* 收藏线路面板样式 - 对应原项目 ExploreMapClient 浮动面板 */
.panel-wrapper {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  z-index: 60;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

/* 收藏列表弹窗 */
.fav-list {
  margin-bottom: 20rpx;
  opacity: 0;
  transform: translateY(16rpx) scale(0.95);
  pointer-events: none;
  transition: all 0.25s ease;
}

.fav-list.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.fav-list-inner {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16px);
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(230, 230, 230, 0.6);
  min-width: 320rpx;
  max-width: 85vw;
  max-height: 40vh;
  overflow-y: auto;
}

.empty-tip {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 40rpx 0;
}

.fav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  transition: background-color 0.2s;
  border: 1rpx solid transparent;
}

.fav-item.active {
  background-color: rgba(79, 140, 255, 0.05);
  border-color: rgba(79, 140, 255, 0.2);
}

.fav-item-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 16rpx;
}

.eye-icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.eye-icon.on {
  background-color: #4f8cff;
  color: #fff;
}

.eye-icon.off {
  background-color: #e5e7eb;
  color: #9ca3af;
}

.fav-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-title.active {
  color: #4f8cff;
}

.fav-remove {
  flex-shrink: 0;
  padding: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
}

.fav-remove:hover {
  color: #ef4444;
}

/* 切换按钮 */
.toggle-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(230, 230, 230, 0.5);
  pointer-events: auto;
}

.toggle-icon {
  font-size: 28rpx;
  color: #6b7280;
}

.toggle-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 2rpx;
}
