/* 路线卡片样式 - 对应原项目 RouteCard */
.route-card {
  display: flex;
  border: 1rpx solid transparent;
  padding: 20rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.3s;
}

.card-default { background-color: #ffffff; border-color: transparent; }
.card-green { background-color: #F4FAF6; border-color: #E2F2E9; }
.card-yellow { background-color: #FFFDF4; border-color: #FDF6E3; }
.card-red { background-color: #FFF5F5; border-color: #FFEAEA; }
.card-custom { background-color: #FDF9F4; border-color: #FBEAD9; }
.card-closed { opacity: 0.75; }

/* 封面图 */
.card-image-wrap {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background-color: #f3f4f6;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40%;
  background: linear-gradient(to top, rgba(0,0,0,0.3), transparent);
  opacity: 0.8;
}

/* 信息区 */
.card-info {
  margin-left: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #111827;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.3;
  flex: 1;
}

/* 收藏按钮 */
.fav-btn {
  flex-shrink: 0;
  padding: 12rpx;
  border-radius: 50%;
}

.fav-active {
  color: #ef4444;
  background-color: #fef2f2;
}

.fav-icon {
  font-size: 28rpx;
  color: #9ca3af;
}

.fav-active .fav-icon {
  color: #ef4444;
}

/* 季节 */
.card-season {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部 */
.card-footer {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 12rpx;
}

.card-distance {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-gray { background-color: #6b7280; color: #ffffff; }
.status-brand { background-color: var(--color-brand); color: #ffffff; }
.status-success { background-color: var(--color-success); color: #ffffff; }
.status-warning { background-color: var(--color-warning); color: #ffffff; }
.status-danger { background-color: var(--color-danger); color: #ffffff; }

.status-text {
  color: inherit;
}
