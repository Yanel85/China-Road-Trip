<!--路线卡片-->
<view class="route-card {{cardBg}} {{data.status && (data.status.includes('封闭') || data.status.includes('closed')) ? 'card-closed' : ''}}">
  <!-- 封面图 -->
  <view class="card-image-wrap">
    <image src="{{coverUrl || data.cover}}" mode="aspectFill" class="card-image" />
    <view class="card-image-overlay"></view>
  </view>

  <!-- 信息区 -->
  <view class="card-info">
    <view class="card-title-row">
      <text class="card-title">{{data.title}}</text>
    </view>

    <!-- 季节 -->
    <text class="card-season" wx:if="{{data.season && data.season.length > 0}}">
      适合季节: {{seasonText}}
    </text>

    <!-- 底部信息 -->
    <view class="card-footer">
      <text class="card-distance">{{data.distance}} km</text>
      <view class="status-tag {{statusColor}}">
        <text class="status-text">{{statusText}}</text>
      </view>
    </view>
  </view>
</view>
