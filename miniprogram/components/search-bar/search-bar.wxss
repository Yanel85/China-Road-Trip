/* 搜索栏样式 - 对应原项目 SearchBar */
.search-bar {
  display: flex;
  align-items: center;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f3f4f6;
  overflow: hidden;
}

.search-icon-wrap {
  width: 96rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  font-size: 36rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #374151;
  background-color: transparent;
}

.search-placeholder {
  color: #9ca3af;
}
