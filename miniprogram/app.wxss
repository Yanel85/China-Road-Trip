/* 全局样式 */
page {
  --color-background: #F8F9FA;
  --color-card: #FFFFFF;
  --color-success: #27AE60;
  --color-warning: #F1C40F;
  --color-danger: #E74C3C;
  --color-brand: #2C3E50;

  --radius-20: 20rpx;
  --shadow-card: 0 4rpx 20rpx rgba(0,0,0,0.05);
  --shadow-sheet: 0 -4rpx 20rpx rgba(0,0,0,0.05);

  font-family: system-ui, -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  background-color: var(--color-background);
  -webkit-font-smoothing: antialiased;
}

/* 隐藏滚动条 */
::-webkit-scrollbar { display: none; }
page { -ms-overflow-style: none; scrollbar-width: none; }
