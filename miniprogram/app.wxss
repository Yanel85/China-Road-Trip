/* 全局样式 - 对应原项目 globals.css */
page {
  --color-background: #F8F9FA;
  --color-card: #FFFFFF;
  --color-success: #27AE60;
  --color-warning: #F1C40F;
  --color-danger: #E74C3C;
  --color-brand: #2C3E50;

  --radius-20: 20rpx;
  --shadow-card: 0 4rpx 20rpx rgba(0,0,0,0.05);
  --shadow-sheet: 0 -4rpx 20rpx rgba(0,0,0,0.05);

  font-family: system-ui, -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  background-color: var(--color-background);
  -webkit-font-smoothing: antialiased;
}

/* 安全区适配 */
.pb-safe {
  padding-bottom: env(safe-area-inset-bottom);
}

.pt-safe {
  padding-top: env(safe-area-inset-top);
}

/* 通用工具类 */
.bg-background { background-color: var(--color-background); }
.bg-card { background-color: var(--color-card); }
.bg-brand { background-color: var(--color-brand); }
.bg-success { background-color: var(--color-success); }
.bg-warning { background-color: var(--color-warning); }
.bg-danger { background-color: var(--color-danger); }

.text-brand { color: var(--color-brand); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger { color: var(--color-danger); }

.shadow-card { box-shadow: var(--shadow-card); }
.shadow-sheet { box-shadow: var(--shadow-sheet); }

.rounded-20 { border-radius: var(--radius-20); }

/* 隐藏滚动条 */
::-webkit-scrollbar { display: none; }
page { -ms-overflow-style: none; scrollbar-width: none; }
